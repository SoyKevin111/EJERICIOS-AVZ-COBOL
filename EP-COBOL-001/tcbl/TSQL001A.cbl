       IDENTIFICATION DIVISION.

       PROGRAM-ID. TSQL001A.


       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
      * SOURCE-COMPUTER. IBM WITH DEBUGGING MODE.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MOV-FILE ASSIGN TO './data/MOVIMIENTOS.TXT'
                  ORGANIZATION IS LINE SEQUENTIAL
                  FILE STATUS IS FS-MOV.
           SELECT ASI-FILE ASSIGN TO './data/ASIENTOS.DAT'
                  ORGANIZATION IS LINE SEQUENTIAL
                  FILE STATUS IS FS-ASI.
           SELECT REP-FILE ASSIGN TO './data/REPORTE.TXT'
                  ORGANIZATION IS LINE SEQUENTIAL
                  FILE STATUS IS FS-REP.
       DATA DIVISION.
       FILE SECTION.
       FD MOV-FILE.
GIXSQL*    EXEC SQL INCLUDE CPY-CB-MOV END-EXEC.
           COPY CPY-CB-MOV.

       FD ASI-FILE.
GIXSQL*    EXEC SQL INCLUDE CPY-CB-ASI END-EXEC.
           COPY CPY-CB-ASI.

       FD REP-FILE.
GIXSQL*    EXEC SQL INCLUDE CPY-CB-REP END-EXEC.
           COPY CPY-CB-REP.


       WORKING-STORAGE SECTION.

GIXSQL*    EXEC SQL INCLUDE CPY-CB-WS END-EXEC.
           COPY CPY-CB-WS.
GIXSQL*    EXEC SQL INCLUDE CPY-CB-HV END-EXEC.
           COPY CPY-CB-HV.
GIXSQL*    EXEC SQL INCLUDE CPY-CB-CX END-EXEC.
           COPY CPY-CB-CX.

GIXSQL*    EXEC SQL INCLUDE SQLCA END-EXEC.
           COPY SQLCA.


GIXSQL 01  SQ0001.
GIXSQL     02  FILLER PIC X(0056) VALUE "SELECT ESTADO FROM SUCURSALES"
GIXSQL  &  " WHERE CODIGO_SUCURSAL = $1".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL 01  SQ0002.
GIXSQL     02  FILLER PIC X(0095) VALUE "SELECT CUENTA_DEBITO , CUENTA"
GIXSQL  &  "_CREDITO , ESTADO FROM TIPOS_MOVIMIENTO WHERE CODIGO_TIPO_M"
GIXSQL  &  "OV = $1".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL 01  SQ0003.
GIXSQL     02  FILLER PIC X(0058) VALUE "SELECT ESTADO FROM PLAN_CUENT"
GIXSQL  &  "AS WHERE CUENTA_CONTABLE = $1".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL 01  SQ0004.
GIXSQL     02  FILLER PIC X(0058) VALUE "SELECT ESTADO FROM PLAN_CUENT"
GIXSQL  &  "AS WHERE CUENTA_CONTABLE = $1".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL 01  SQ0005.
GIXSQL     02  FILLER PIC X(0180) VALUE "INSERT INTO MOVIMIENTOS (FECH"
GIXSQL  &  "A_MOVIMIENTO , NUMERO_MOVIMIENTO , CODIGO_SUCURSAL , CODIGO"
GIXSQL  &  "_TIPO_MOV , REFERENCIA , VALOR , FECHA_CONTABLE) VALUES ( $"
GIXSQL  &  "1 , $2 , $3 , $4 , $5 , $6 , $7 )".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL 01  SQ0006.
GIXSQL     02  FILLER PIC X(0163) VALUE "INSERT INTO ASIENTOS_CONTABLE"
GIXSQL  &  "S (FECHA_CONTABLE , NUMERO_MOVIMIENTO , CUENTA_CONTABLE , T"
GIXSQL  &  "IPO_AFECTACION , VALOR , REFERENCIA) VALUES ( $1 , $2 , $3 "
GIXSQL  &  ", $4 , $5 , $6 )".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL*   ESQL CURSOR INIT FLAGS (START)
GIXSQL*   ESQL CURSOR INIT FLAGS (END)
       PROCEDURE DIVISION.
GIXSQL*    EXEC SQL WHENEVER SQLERROR CONTINUE END-EXEC.
GIXSQL*    EXEC SQL WHENEVER NOT FOUND CONTINUE END-EXEC.

       100-MAIN.
           PERFORM 000-CONNECT.
           PERFORM 5000-CARGAR-ARCHIVOS.
           DISPLAY 'INGRESE FECHA CONTABLE (AAAAMMDD): '
                   WITH NO ADVANCING.
           ACCEPT IN-FECHA-CONTABLE.
           DISPLAY 'FECHA CONTABLE: ' IN-FECHA-CONTABLE.
           PERFORM 5200-PROCESAR-DATOS.
           PERFORM 5100-CERRAR-ARCHIVOS.
           PERFORM 6000-GENERAR-REPORTE.
           DISPLAY 'LEIDOS ......... ' WS-LEIDOS.
           DISPLAY 'CONTABILIZADOS . ' WS-CONTABILIZADOS.
           DISPLAY 'RECHAZADOS ..... ' WS-RECHAZADOS.
           PERFORM 100-EXIT.


       000-CONNECT.
           ACCEPT DATASRC FROM ENVIRONMENT 'DB1SRC'.
           ACCEPT DBUSR FROM ENVIRONMENT 'DB1USER'.
           ACCEPT DBPWD FROM ENVIRONMENT 'DB1PASS'.
GIXSQL*    EXEC SQL
GIXSQL*    CONNECT TO :DATASRC USER :DBUSR USING :DBPWD
GIXSQL*    END-EXEC.
GIXSQL     CALL STATIC "GIXSQLConnect" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE DATASRC
GIXSQL         BY VALUE 64
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE DBUSR
GIXSQL         BY VALUE 64
GIXSQL         BY REFERENCE DBPWD
GIXSQL         BY VALUE 64
GIXSQL     END-CALL.
           IF SQLCODE <> 0
              DISPLAY 'ERROR DE CONEXION. SQLCODE=' SQLCODE
              GO TO 100-EXIT
           END-IF.


       5000-CARGAR-ARCHIVOS.
           OPEN INPUT MOV-FILE.
           IF FS-MOV <> '00'
              DISPLAY 'ERROR, CARGA DE MOVIMIENTOS.TXT FS=' FS-MOV
              GO TO 100-EXIT
           END-IF.
           OPEN OUTPUT ASI-FILE.
           IF FS-ASI <> '00'
              DISPLAY 'ERROR, CREACION DE ASIENTOS.DAT FS=' FS-ASI
              GO TO 100-EXIT
           END-IF.

       5100-CERRAR-ARCHIVOS.
           CLOSE MOV-FILE.
           IF FS-MOV NOT = '00'
              DISPLAY 'ERROR AL CERRAR MOVIMIENTOS.TXT ' FS-MOV
           END-IF.
           CLOSE ASI-FILE.
           IF FS-ASI NOT = '00'
              DISPLAY 'ERROR AL CERRAR ASIENTOS.DAT ' FS-ASI
           END-IF.

       5200-PROCESAR-DATOS.
           PERFORM UNTIL FIN-ARCHIVO
              READ MOV-FILE
                 AT END
                    SET FIN-ARCHIVO TO TRUE
                 NOT AT END
                    ADD 1 TO WS-LEIDOS
                    SET MOV-VALIDO TO TRUE
                    PERFORM 5210-VALIDAR-MOVIMIENTOS
                    IF MOV-VALIDO
                       PERFORM 5220-GENERAR-ASIENTOS
                       ADD 1 TO WS-CONTABILIZADOS
GIXSQL*                    EXEC SQL COMMIT END-EXEC
GIXSQL     CALL STATIC "GIXSQLStartSQL"
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLExec" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE "COMMIT" & x"00"
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLEndSQL"
GIXSQL     END-CALL
                    ELSE
                       ADD 1 TO WS-RECHAZADOS
                    END-IF
              END-READ
           END-PERFORM.

      
       5210-VALIDAR-MOVIMIENTOS.

      *    VALIDAR FECHA CONTABLE
           IF IN-FECHA-CONTABLE NOT = 0
              IF RM-FECHA-MOVIMIENTO NOT = IN-FECHA-CONTABLE
                 SET MOV-RECHAZADO TO TRUE
                 DISPLAY 'RECHAZO ' RM-NUMERO-MOVIMIENTO
                         ' FECHA NO CORRESPONDE'
              END-IF
           END-IF.

      *    VALIDAR VALOR
           IF MOV-VALIDO
              IF RM-VALOR <= 0
                 SET MOV-RECHAZADO TO TRUE
                 ADD 1 TO WS-RECH-VALOR
                 DISPLAY 'RECHAZO ' RM-NUMERO-MOVIMIENTO
                         ' VALOR INVALIDO'
              END-IF
           END-IF.

      *    VALIDAR SUCURSAL Y ESTADO
           IF MOV-VALIDO
              MOVE SPACES TO HV-ESTADO
GIXSQL*                      EXEC SQL
GIXSQL*                      SELECT ESTADO INTO :HV-ESTADO
GIXSQL*                      FROM SUCURSALES
GIXSQL*                      WHERE CODIGO_SUCURSAL = :RM-CODIGO-SUCURSAL
GIXSQL*                      END-EXEC
GIXSQL     CALL STATIC "GIXSQLStartSQL"
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLSetResultParams" USING
GIXSQL         BY VALUE 16
GIXSQL         BY VALUE 1
GIXSQL         BY VALUE 0
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE HV-ESTADO
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLSetSQLParams" USING
GIXSQL         BY VALUE 16
GIXSQL         BY VALUE 4
GIXSQL         BY VALUE 0
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE RM-CODIGO-SUCURSAL
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLExecSelectIntoOne" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE SQ0001
GIXSQL         BY VALUE 1
GIXSQL         BY VALUE 1
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLEndSQL"
GIXSQL     END-CALL
              IF SQLCODE NOT = 0
                 SET MOV-RECHAZADO TO TRUE
                 ADD 1 TO WS-RECH-SUC-INEX
                 DISPLAY 'RECHAZO ' RM-NUMERO-MOVIMIENTO
                         ' SUCURSAL INEXISTENTE'
              ELSE
                 IF HV-ESTADO NOT = 'A'
                    SET MOV-RECHAZADO TO TRUE
                    ADD 1 TO WS-RECH-SUC-INAC
                    DISPLAY 'RECHAZO ' RM-NUMERO-MOVIMIENTO
                            ' SUCURSAL INACTIVA'
                 END-IF
              END-IF
           END-IF.


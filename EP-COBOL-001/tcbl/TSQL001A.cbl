GIXSQL*                     SELECT CUENTA_DEBITO, CUENTA_CREDITO, ESTADO
GIXSQL*           INTO :HV-CUENTA-DEBITO, :HV-CUENTA-CREDITO, :HV-ESTADO
GIXSQL*                      FROM TIPOS_MOVIMIENTO
GIXSQL*                      WHERE CODIGO_TIPO_MOV = :RM-CODIGO-TIPO-MOV
GIXSQL*                      END-EXEC

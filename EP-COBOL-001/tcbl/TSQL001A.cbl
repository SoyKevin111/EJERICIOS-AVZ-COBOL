GIXSQL         BY VALUE 1
GIXSQL         BY VALUE 11
GIXSQL         BY VALUE -2
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE HV-ASI-VALOR
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLSetSQLParams" USING
GIXSQL         BY VALUE 16
GIXSQL         BY VALUE 20
GIXSQL         BY VALUE 0
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE HV-ASI-REF
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLExecParams" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE SQ0006
GIXSQL         BY VALUE 6
GIXSQL     END-CALL
GIXSQL     CALL STATIC "GIXSQLEndSQL"
GIXSQL     END-CALL
              IF SQLCODE NOT = 0
                 DISPLAY 'ERROR INSERT ASIENTO SQLCODE=' SQLCODE
                         ' MOV=' RM-NUMERO-MOVIMIENTO
              ELSE
                 MOVE HV-ASI-FECHA    TO DAT-FECHA-CONTABLE
                 MOVE HV-ASI-NUMMOV   TO DAT-NUMERO-MOVIMIENTO
                 MOVE HV-ASI-CUENTA   TO DAT-CUENTA-CONTABLE
                 MOVE HV-ASI-TIPOAFEC TO DAT-TIPO-AFECTACION
                 MOVE HV-ASI-VALOR    TO DAT-VALOR
                 MOVE HV-ASI-REF      TO DAT-REFERENCIA
                 WRITE REG-ASI-DAT
                 IF FS-ASI NOT = '00'
                    DISPLAY 'ERROR ESCRITURA ASIENTO FS=' FS-ASI
                 END-IF
              END-IF
           END-PERFORM.


      * genera el archivo de reporte
       6000-GENERAR-REPORTE.
           OPEN OUTPUT REP-FILE.

           MOVE IN-FECHA-CONTABLE TO WS-LF-VAL.
           WRITE REP-REG FROM WS-LIN-FEC.
           MOVE SPACES TO REP-REG.
           WRITE REP-REG.

           MOVE 'TOTAL REGISTROS LEIDOS'           TO WS-LN-TXT.
           MOVE WS-LEIDOS                          TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE 'TOTAL MOVIMIENTOS CONTABILIZADOS' TO WS-LN-TXT.
           MOVE WS-CONTABILIZADOS                  TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE 'TOTAL MOVIMIENTOS RECHAZADOS'     TO WS-LN-TXT.
           MOVE WS-RECHAZADOS                      TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE SPACES TO REP-REG.
           WRITE REP-REG.

           MOVE 'RECHAZADOS POR SUCURSAL INEXISTENTE' TO WS-LN-TXT.
           MOVE WS-RECH-SUC-INEX                      TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE 'RECHAZADOS POR SUCURSAL INACTIVA'  TO WS-LN-TXT.
           MOVE WS-RECH-SUC-INAC                    TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE 'RECHAZADOS POR TIPO MOVIMIENTO'    TO WS-LN-TXT.
           MOVE WS-RECH-TIPO-MOV                    TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE 'RECHAZADOS POR CUENTA INACTIVA'    TO WS-LN-TXT.
           MOVE WS-RECH-CTA-INAC                    TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE 'RECHAZADOS POR VALOR INVALIDO'     TO WS-LN-TXT.
           MOVE WS-RECH-VALOR                       TO WS-LN-VAL.
           WRITE REP-REG FROM WS-LIN-NUM.

           MOVE SPACES TO REP-REG.
           WRITE REP-REG.

           MOVE 'TOTAL DEBITOS GENERADOS'           TO WS-LM-TXT.
           MOVE WS-TOT-DEBITO                       TO WS-LM-VAL.
           WRITE REP-REG FROM WS-LIN-MON.

           MOVE 'TOTAL CREDITOS GENERADOS'          TO WS-LM-TXT.
           MOVE WS-TOT-CREDITO                      TO WS-LM-VAL.
           WRITE REP-REG FROM WS-LIN-MON.

           MOVE SPACES TO REP-REG.
           WRITE REP-REG.

           IF WS-TOT-DEBITO = WS-TOT-CREDITO
              MOVE 'CUADRE CONTABLE : CORRECTO'  TO REP-REG
           ELSE
              MOVE 'CUADRE CONTABLE : DESCUADRE' TO REP-REG
           END-IF.
           WRITE REP-REG.

           CLOSE REP-FILE.
           DISPLAY 'REPORTE GENERADO EN ./data/REPORTE.TXT'.


       100-EXIT.
